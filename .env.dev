APP_TITLE="App"
APP_DESCRIPTION="Python REST Application"
APP_VERSION="1.0.0"

APP_REST_HOST="127.0.0.1"
APP_REST_PORT="8000"

APP_DB_DSN="postgresql+asyncpg://app:app@127.0.0.1:5432/app"
APP_DB_POOL_SIZE=10
APP_DB_POOL_TIMEOUT=10

APP_SECRET="secret"

APP_S3_ACCESS_KEY="secret"
APP_S3_SECRET_KEY="secret123"
APP_S3_BUCKET="app"
APP_S3_ENDPOINT_URL="http://127.0.0.1:9000"
APP_S3_MAX_POOL_CONNECTIONS=10
APP_S3_MAX_ATTEMPTS=5
APP_S3_MULTIPART_CHUNK_SIZE=5242880
